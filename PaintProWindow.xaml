<Window x:Class="SDK_HD.Dim.PaintProWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KTool | PaintPro" Height="690" Width="990" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#232B37"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB7C9"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#46B9AC"/>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PAINTPRO" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Material browser  •  Revit project" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="PROJECT MATERIALS" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBox x:Name="SearchBox" Grid.Row="1" Height="34" Padding="9,6" Background="#171C25" Foreground="White" BorderBrush="#445163" TextChanged="SearchBox_TextChanged" ToolTip="Tìm vật liệu theo tên"/>
                    <ListBox x:Name="MaterialsList" Grid.Row="2" Margin="0,12" Background="{StaticResource PanelBrush}" BorderThickness="0" Foreground="White" DisplayMemberPath="Name" SelectionChanged="MaterialsList_SelectionChanged"/>
                    <StackPanel Grid.Row="3">
                        <Button Style="{StaticResource ActionButton}" Content="↻  Refresh materials" Click="RefreshButton_Click" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ActionButton}" Content="◉  Hút vật liệu từ bề mặt" Click="PickMaterialButton_Click" Margin="0,0,0,10" ToolTip="Chọn một mặt trong Revit để lấy vật liệu"/>
                        <Button Style="{StaticResource ActionButton}" Content="▣  Paint liên tục (Esc để kết thúc)" Click="PaintButton_Click" ToolTip="Chọn liên tiếp nhiều mặt; nhấn Esc để kết thúc phiên Paint"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MATERIAL PREVIEW" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        <Border x:Name="ColorSwatch" Height="180" Margin="0,18" CornerRadius="8" BorderBrush="#536173" BorderThickness="1" Background="#171C25"/>
                        <TextBlock x:Name="MaterialNameText" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MaterialDetailsText" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="29"/>
                        <TextBlock Text="Chọn vật liệu bên trái, sau đó bấm Paint để sơn các mặt trong mô hình. Esc để kết thúc." Foreground="{StaticResource AccentBrush}" Margin="0,24,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
